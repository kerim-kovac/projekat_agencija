<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista putovanja</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/Agencija/home-agencija-lista-putovanja.css" />
</head>

<body>

<nav class="navbar">
  <div class="navbar-brand">TERRA<span>VISTA</span></div>

  <a href="/home-agencija" style="border:1px solid #ddd;color:#888;border-radius:8px;padding:8px 18px;text-decoration:none;font-size:14px;">
    <i class="bi bi-arrow-left me-1"></i> Nazad
  </a>
</nav>

<div class="page-header">
  <h1>
    <i class="bi bi-globe2 me-2"></i>
    Lista putovanja
  </h1>
</div>

<div class="content">
  <div class="search-bar">
    <form action="/home-agencija/lista-putovanja/result" method="GET">
      <input type="text" name="input" placeholder="Pretraga putovanja...">
      <button type="submit">Search</button>
    </form>
  </div>
  <div class="table-wrap">

    <table class="table">
      <thead>
        <tr>
          <th>Agencija</th>
          <th>Država</th>
          <th>Grad</th>
          <th>Opis</th>
          <th>Datum</th>
          <th>Min</th>
          <th>Max</th>
          <th>Cijena</th>
          <th>Akcija</th>
        </tr>
      </thead>

      <tbody>
        <% putovanja.forEach((putovanje) => { %>
        <tr>

          <td>
            <span class="badge-agencija">
              <%= putovanje.agencija %>
            </span>
          </td>

          <td><%= putovanje.drzava %></td>
          <td><%= putovanje.grad %></td>
          <td><%= putovanje.deskripcija %></td>

          <td>
            <i class="bi bi-calendar3 me-1" style="color:#3b82f6;"></i>
            <%= putovanje.datum %>
          </td>

          <td><%= putovanje.min %></td>
          <td><%= putovanje.max %></td>

          <td class="price">
            <%= putovanje.cijena %>
            <i class="bi bi-currency-euro"></i>
          </td>

          <td>
              <form action="/home-agencija/lista-putovanja" method="POST">
                <input type="hidden" name="id" value="<%= putovanje.id %>">

                <button type="submit"
                        class="btn-obrisi"
                        onclick="return confirm('Da li ste sigurni da želite obrisati putovanje?')">

                  <i class="bi bi-trash me-1"></i>
                  Obriši

                </button>
              </form>
          </td>

        </tr>
        <% }) %>
      </tbody>

    </table>

  </div>
</div>

</body>
</html>