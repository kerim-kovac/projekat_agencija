<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Agencije</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
     integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
     crossorigin=""></script>
    <link rel="stylesheet" href="/stylesheets/Agencija/home-agencija.css" />
  </head>
  <body>

  <nav>
    <div class="brand">Terra<span>Vista</span></div>

    <div class="nav-right">
      <a href="/home-agencija/logout" class="btn-logout">
        <i class="bi bi-box-arrow-right"></i>
        Odjava
      </a>
    </div>
  </nav>

  <div class="hero">
    <h1>
      Dobrodošli,
      <span><%= agencija.naziv %></span>
    </h1>

    <p>Upravljajte vašim putovanjima i korisnicima na jednom mjestu.</p>

    <span class="role-tag">
      <i class="bi bi-shield-check me-1"></i>
      <%= agencija.role %>
    </span>
  </div>

  <div class="kartice">
    <div class="container-fluid">
      <div class="row g-4">

        <div class="col-lg-3 col-md-6">
          <a href="/home-agencija/kreiraj-putovanje" class="kartica">

            <div class="kartica-icon">
              <i class="bi bi-plus-circle"></i>
            </div>

            <h3>Kreiraj putovanje</h3>

            <p>
              Dodajte novo putovanje i ponudite ga korisnicima.
            </p>

          </a>
        </div>

        <div class="col-lg-3 col-md-6">
          <a href="/home-agencija/lista-putovanja" class="kartica">

            <div class="kartica-icon">
              <i class="bi bi-globe2"></i>
            </div>

            <h3>Lista putovanja</h3>

            <p>
              Pregledajte i upravljajte svim vašim putovanjima.
            </p>

          </a>
        </div>

        <div class="col-lg-3 col-md-6">
          <a href="/home-agencija/prijavljeni-useri" class="kartica">

            <div class="kartica-icon">
              <i class="bi bi-people"></i>
            </div>

            <h3>Prijavljeni korisnici</h3>

            <p>
              Pregledajte korisnike prijavljene na vaša putovanja.
            </p>

          </a>
        </div>

        <div class="col-lg-3 col-md-6">
          <a href="/home-agencija/postavke" class="kartica">

            <div class="kartica-icon">
              <i class="bi bi-gear"></i>
            </div>

            <h3>Opcije</h3>

            <p>
              Uredite podatke vaše agencije i postavke naloga.
            </p>

          </a>
        </div>

      </div>
    </div>
  </div>

  <div class="map-section">

    

    <div id="map"></div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const map = L.map('map').setView([43.8563, 18.4131], 5);

    L.tileLayer(
      'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
      {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap'
      }
    ).addTo(map);

    L.marker([43.8563, 18.4131])
      .addTo(map)
      .bindPopup('TerraVista');
  </script>

</body>
</html>