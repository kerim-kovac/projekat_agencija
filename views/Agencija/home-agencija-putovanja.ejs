<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kreiraj putovanje</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/Agencija/home-agencija-putovanja.css" />
  </head>

  <body>

    <nav class="top-nav">
      <a href="/home-agencija">
        <i class="bi bi-arrow-left"></i>
        Nazad
      </a>
    </nav>

    <div class="card">

      <div class="header">
        <div class="brand">TERRA<span>VISTA</span></div>
        <h1>Kreirajte putovanje</h1>
        <p>Dodajte novo putovanje u sistem</p>
      </div>

      <form action="/home-agencija/kreiraj-putovanje" method="POST">

        <div class="row g-3">

          <div class="col-md-6">
            <label>DRZAVA</label>
            <input type="text" name="drzava" required>
          </div>

          <div class="col-md-6">
            <label>GRAD</label>
            <input type="text" name="grad" required>
          </div>

          <div class="col-md-6">
            <label>DESKRIPCIJA</label>
            <input type="text" name="deskripcija" required>
          </div>

          <div class="col-md-6">
            <label>DATUM</label>
            <input type="date" name="datum" required>
          </div>

          <div class="col-md-6">
            <label>MINIMALAN BROJ LJUDI</label>
            <input type="number" name="minimalan" required>
          </div>

          <div class="col-md-6">
            <label>MAXIMALAN BROJ LJUDI</label>
            <input type="number" name="maximalan" required>
          </div>

          <div class="col-md-6">
            <label>CIJENA</label>
            <input type="number" name="cijena" required>
          </div>

          <div class="col-md-6">
            <label>PREVOZ</label>
            <input type="text" name="prevoz" required>
          </div>

          <div class="col-md-6">
            <label>LAT</label>
            <input type="number" name="lat" step="any" required>
          </div>

          <div class="col-md-6">
            <label>lng</label>
            <input type="number" name="lng" step="any" required>
          </div>

        </div>

        <button type="submit">KREIRAJ PUTOVANJE</button>

      </form>

    </div>

  </body>
</html>