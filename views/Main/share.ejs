<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Putovanje <%= podaci.drzava%></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/Main/share.css" />
  
</head>

<body>

  <div class="wrap">

    <div class="card">

      <div class="badge-top">
        <i class="bi bi-share"></i> Podijeli sa prijateljima
      </div>

      <h1><%= podaci.drzava %></h1>

      <div class="info">

        <div class="row-item">
          <span class="label">Grad</span>
          <span class="value"><%= podaci.grad %></span>
        </div>

        <div class="row-item">
          <span class="label">Opis</span>
          <span class="value"><%= podaci.deskripcija %></span>
        </div>

        <div class="row-item">
          <span class="label">Datum</span>
          <span class="value">
            <i class="bi bi-calendar3 icon"></i>
            <%= podaci.datum %>
          </span>
        </div>

      </div>

    </div>

  </div>

</body>
</html>