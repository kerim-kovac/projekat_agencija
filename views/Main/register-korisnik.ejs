<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registracija korisnika</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/Main/register-korisnik.css">

  </head>
  <body>

    <div class="card">
      <div class="text-center mb-4">
        <div class="logo-text mb-3">TERRA<span>VISTA</span></div>
        <h1>Registracija korisnika</h1>
        <p class="subtitle">Kreirajte vaš korisnički nalog</p>
      </div>
   <% if(typeof poruka !== 'undefined' && greska==true){ %>
      <div class="alert alert-danger">
      <%= poruka %>
      </div>
        <% }else if(typeof poruka !== 'undefined' && greska==false){ %>
      <div class="alert alert-success">
      <%= poruka %>
      </div>
      <%  }%>
      <div class="divider"></div>

      <form action="/register/korisnik" method="POST">
        <div class="row">
          <div class="col-6 mb-3">
            <label><i class="bi bi-person me-1"></i> Ime</label>
            <input type="text" class="form-control" name="ime" placeholder="Vaše ime" required>
          </div>
          <div class="col-6 mb-3">
            <label><i class="bi bi-person me-1"></i> Prezime</label>
            <input type="text" class="form-control" name="prezime" placeholder="Vaše prezime" required>
          </div>
        </div>

        <div class="mb-3">
          <label><i class="bi bi-at me-1"></i> Username</label>
          <input type="text" class="form-control" name="username" placeholder="Odaberite username" required>
        </div>

        <div class="mb-3">
          <label><i class="bi bi-envelope me-1"></i> Email</label>
          <input type="email" class="form-control" name="email" placeholder="vas@email.com" required>
        </div>

        <div class="mb-3">
          <label><i class="bi bi-lock me-1"></i> Password</label>
          <input type="password" class="form-control" name="password" placeholder="••••••••" required>
        </div>

        <div class="mb-4">
          <label><i class="bi bi-lock-fill me-1"></i> Repeat Password</label>
          <input type="password" class="form-control" name="ponovljeni" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn-submit">
          <i class="bi bi-person-check me-2"></i> Registruj se
        </button>
      </form>

      <div class="text-center mt-4">
        <a href="/register" class="nazad-link">
          <i class="bi bi-arrow-left me-1"></i> Nazad
        </a>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>