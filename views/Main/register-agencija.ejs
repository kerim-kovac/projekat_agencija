
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registracija agencije - TerraVista</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/Main/register-agencija.css">
</head>

<body>

    <div class="register-container">
        <div class="text-center mb-4">
        <div class="brand">
            Terra<span>Vista</span>
        </div>

        <h1>Registruj <span>agenciju</span></h1>

        <p class="subtitle">
            Unesite podatke vaše turističke agencije kako biste započeli sa objavljivanjem i upravljanjem putovanjima.
        </p>
        </div>
        <% if(typeof poruka !== 'undefined' && greska==true){ %>
        <div class="alert alert-danger">
            <%= poruka %>
        </div>
        <% }else if(typeof poruka !== 'undefined' && greska==false){ %>
        <div class="alert alert-success">
            <%= poruka %>
        </div>
        <% } %>

        <div class="divider"></div>

        <form action="/register/agencija" method="POST">

            <div class="mb-3">
                <label>
                    <i class="bi bi-building me-1"></i>
                    Naziv agencije
                </label>

                <input
                    type="text"
                    class="form-control"
                    name="naziv_agencije"
                    placeholder="Unesite naziv agencije">
            </div>

            <div class="mb-3">
                <label>
                    <i class="bi bi-envelope me-1"></i>
                    E-mail
                </label>

                <input
                    type="email"
                    class="form-control"
                    name="email"
                    placeholder="agencija@email.com">
            </div>

            <div class="mb-3">
                <label>
                    <i class="bi bi-calendar me-1"></i>
                    Datum osnivanja
                </label>

                <input
                    type="date"
                    class="form-control"
                    name="datum_osnivanja">
            </div>

            <div class="mb-3">
                <label>
                    <i class="bi bi-lock me-1"></i>
                    Lozinka
                </label>

                <input
                    type="password"
                    class="form-control"
                    name="password"
                    placeholder="••••••••">
            </div>

            <div class="mb-4">
                <label>
                    <i class="bi bi-lock-fill me-1"></i>
                    Ponovljena lozinka
                </label>

                <input
                    type="password"
                    class="form-control"
                    name="ponovljena_lozinka"
                    placeholder="••••••••">
            </div>

            <button type="submit" class="btn-submit">
                <i class="bi bi-check2-circle me-2"></i>
                Registruj agenciju
            </button>

        </form>

        <div class="back-link">
            <a href="/register">
                <i class="bi bi-arrow-left me-1"></i>
                Nazad
            </a>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

