<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registracija</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/Main/register.css" />
  </head>
  <body>

    <div class="card">
      <div class="text-center mb-4">
        <div class="logo-text mb-3">TERRA<span>VISTA</span></div>
        <h1>Dobrodošli</h1>
        <p>Odaberite tip registracije da biste nastavili</p>
      </div>

      <div class="divider"></div>

      <div class="d-flex flex-column gap-3">
        <a href="/register/agencija" class="text-decoration-none">
          <button class="btn-agencija">
            <i class="bi bi-building me-2"></i> Registruj agenciju
          </button>
        </a>

        <a href="/register/korisnik" class="text-decoration-none">
          <button class="btn-korisnik">
            <i class="bi bi-person me-2"></i> Registruj korisnika
          </button>
        </a>
      </div>
      <div class="back-link">
            <a href="/">
                <i class="bi bi-arrow-left me-1"></i>
                Nazad
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>