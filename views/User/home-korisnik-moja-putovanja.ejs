<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moja putovanja</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <link rel="stylesheet" href="/stylesheets/User/home-korisnik-moja-putovanja.css" />
</head>

<body>

<nav class="navbar d-flex justify-content-between align-items-center">
  <div class="navbar-brand">TERRA<span>VISTA</span></div>

  <a href="/home" style="border:1px solid #ddd;color:#888;border-radius:8px;padding:8px 18px;text-decoration:none;">
    <i class="bi bi-arrow-left me-1"></i> Nazad
  </a>
</nav>

<div class="page-header">
  <h1>
    <i class="bi bi-globe2 me-2"></i>
    Moja putovanja
  </h1>
</div>



<div class="content">
  <div class="search-bar">
    <form action="/home/moja-putovanja/result" method="GET">
      <input type="text" name="input" placeholder="Unesite državu...">
      <button type="submit">Search</button>
    </form>
  </div>
  <div class="table-wrap">

    <table class="table">
      <thead>
        <tr>
          <th>Agencija</th>
          <th>Država</th>
          <th>Grad</th>
          <th>Datum</th>
          <th>Cijena</th>
          <th>Tip</th>
          <th>Prevoz</th>
          <th>Akcija</th>
          <th>PDF</th>
        </tr>
      </thead>

      <tbody>
        <% putovanja.forEach((putovanje) => { %>
        <tr>

          <td><span class="badge-agencija"><%= putovanje.agencija %></span></td>
          <td><%= putovanje.drzava %></td>
          <td><%= putovanje.grad %></td>

          <td>
            <i class="bi bi-calendar3"></i>
            <%= putovanje.datum %>
          </td>

          <td>
            <strong>
              <%= putovanje.cijena %>
              <i class="bi bi-currency-euro" style="color:#3b82f6;"></i>
            </strong>
          </td>

          <td><%= putovanje.tip_putovanja %></td>
          <td><%= putovanje.prevoz %></td>

          <td>
            <% if(putovanje.shared == 0){ %>
              <form action="/home/moja-putovanja/ukljuci-dijeljenje" method="POST">
                <input type="hidden" name="korisnikovId" value="<%=putovanje.korisnikov_id %>">
                <input type="hidden" name="putovanjeId" value="<%=putovanje.putovanje_id %>">
                <button class="btn-main">Uključi</button>
              </form>
            <% } else { %>
              <form action="/home/moja-putovanja/podijeli-objavu" method="POST">
                <input type="hidden" name="korisnikovId" value="<%=putovanje.korisnikov_id %>">
                <input type="hidden" name="putovanjeId" value="<%=putovanje.putovanje_id %>">
                <button class="btn-main">Podijeli</button>
              </form>

              <form action="/home/moja-putovanja/iskljuci-dijeljenje" method="POST">
                <input type="hidden" name="korisnikovId" value="<%=putovanje.korisnikov_id %>">
                <input type="hidden" name="putovanjeId" value="<%=putovanje.putovanje_id %>">
                <button class="btn-danger-custom">Isključi</button>
              </form>
            <% } %>
          </td>

          <td>
            <form action="/home/moja-putovanja/putovanje-pdf" method="GET">
              <input type="hidden" name="korisnikovId" value="<%=putovanje.korisnikov_id %>">
              <input type="hidden" name="putovanjeId" value="<%=putovanje.putovanje_id %>">
              <button class="btn-pdf">
                <i class="bi bi-file-earmark-pdf-fill"></i>
              </button>
            </form>
          </td>

        </tr>
        <% }) %>
      </tbody>

    </table>

  </div>
</div>

</body>
</html>