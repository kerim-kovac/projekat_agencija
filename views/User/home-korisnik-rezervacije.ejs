<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moje rezervacije</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/User/home-korisnik-rezervacije.css" />
</head>

<body>

<nav class="navbar d-flex justify-content-between align-items-center">
  <div class="navbar-brand">TERRA<span>VISTA</span></div>

  <a href="/home" class="nav-back">
    <i class="bi bi-arrow-left me-1"></i>
    Nazad
  </a>
</nav>

<div class="page-header">
  <h1>
    <i class="bi bi-globe2 me-2"></i>
    Moje rezervacije
  </h1>
</div>

<div class="content">

  <div class="table-wrap">

    <table class="table">

      <thead>
        <tr>
          <th>Država</th>
          <th>Grad</th>
          <th> Datum</th>
          <th>Cijena</th>
          <th>Status</th>
          <th>Akcija</th>
        </tr>
      </thead>

      <tbody>

        <% podaci.forEach((podatak) => { %>

        <tr>
          <td><%= podatak.drzava %></td>

          <td><%= podatak.grad %></td>

          <td>
            <i class="bi bi-calendar me-1" style="color:#3b82f6;"></i>
            <%= podatak.datum %>
          </td>

          <td>
            <span class="price">
              <i class="bi bi-currency-euro"></i>
              <%= podatak.cijena %>
            </span>
          </td>

          <td>
            <% if(podatak.aktivan == 0) { %>
              <span class="status status-0">Na čekanju</span>
            <% } else if(podatak.aktivan == 1) { %>
              <span class="status status-1">Odobreno</span>
            <% } else if(podatak.aktivan == 2) { %>
              <span class="status status-2">Odbijeno</span>
            <% } %>
          </td>

          <td>
            <form action="/home/rezervacije/odjava" method="POST">
              <input type="hidden" name="putovanjeId" value="<%= podatak.putovanje_id %>">
              <button type="submit" class="btn-danger" onclick="return confirm('Da li ste sigurni da se želite odjaviti sa putovanja?')">
                <i class="bi bi-x-circle me-1"></i>
                Odjavi se
              </button>
            </form>
          </td>

        </tr>

        <% }) %>

      </tbody>

    </table>

  </div>

</div>

</body>
</html>