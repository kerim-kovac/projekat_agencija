
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Postavke</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/User/home-postavke.css" />
 
</head>

<body>

  <nav class="navbar d-flex justify-content-between align-items-center">
    <div class="navbar-brand">
      TERRA<span>VISTA</span>
    </div>

    <a href="/home" class="nav-back">
      <i class="bi bi-arrow-left me-1"></i>
      Nazad
    </a>
  </nav>

  <div class="content">

    <h1 class="page-title">
      <i class="bi bi-gear me-2"></i>
      Postavke
    </h1>

    <!-- INFO -->
    <div class="card-box">
      <h5><i class="bi bi-person me-1"></i> Vaši podaci</h5>

      <div class="info-row">
        <span class="info-label">Ime</span>
        <span class="info-value"><%= korisnik.ime %></span>
      </div>

      <div class="info-row">
        <span class="info-label">Prezime</span>
        <span class="info-value"><%= korisnik.prezime %></span>
      </div>

      <div class="info-row">
        <span class="info-label">Username</span>
        <span class="info-value"><%= korisnik.username %></span>
      </div>

      <div class="info-row">
        <span class="info-label">Email</span>
        <span class="info-value"><%= korisnik.email %></span>
      </div>
    </div>

    <!-- IME/PREZIME -->
    <div class="card-box">
      <h5><i class="bi bi-pencil me-1"></i> Promjena imena i prezimena</h5>

      <form action="/home/postavke/promjena-imena-prezimena" method="POST">

        <div class="row g-3 mb-3">
          <div class="col-6">
            <label>Novo ime</label>
            <input type="text" class="form-control" name="novoIme" required>
          </div>

          <div class="col-6">
            <label>Novo prezime</label>
            <input type="text" class="form-control" name="novoPrezime" required>
          </div>
        </div>

        <button type="submit" class="btn-submit">
          <i class="bi bi-check2 me-1"></i>
          Promijeni
        </button>

      </form>
    </div>

    <!-- LOZINKA -->
    <div class="card-box">
      <h5><i class="bi bi-lock me-1"></i> Promjena lozinke</h5>

      <form action="/home/postavke/promjena-sifre" method="POST">

        <div class="mb-3">
          <label>Trenutna lozinka</label>
          <input type="password" class="form-control" name="trenutna" required>
        </div>

        <div class="mb-3">
          <label>Nova lozinka</label>
          <input type="password" class="form-control" name="nova" required>
        </div>

        <button type="submit" class="btn-submit">
          <i class="bi bi-check2 me-1"></i>
          Promijeni
        </button>

      </form>
    </div>

  </div>
  <footer class="footer">
  <div class="footer-content">
    <p><strong>Kerim Kovač</strong> – Informacione tehnologije</p>
    <p>Index: 488/IT-25</p>
    <p>Predmet: Razvoj web aplikacija 1</p>
    <p>Projekat: Agencija</p>
  </div>
</footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
